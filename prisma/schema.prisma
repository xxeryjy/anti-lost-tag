generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PreferredLocale {
  ZH_CN
  EN
  JA
}

enum TagStatus {
  INACTIVE
  ACTIVE
  LOST
}

enum ProfileCategory {
  PET
  ITEM
}

enum PetKind {
  CAT
  DOG
  OTHER
}

enum ProfileSex {
  MALE
  FEMALE
  UNKNOWN
}

enum LocationSource {
  GPS
  IP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id               Int             @id @default(autoincrement())
  email            String          @unique
  passwordHash     String
  emailVerifiedAt  DateTime?
  preferredLocale  PreferredLocale @default(EN)
  timezone         String          @default("UTC")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tags             Tag[]

  @@index([preferredLocale])
}

model Tag {
  id                 Int        @id @default(autoincrement())
  uid                String     @unique
  activationCode     String
  status             TagStatus  @default(INACTIVE)
  rewardText         String?
  activatedAt        DateTime?
  userId             Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile            TagProfile?
  scans              ScanLog[]
  privacyMessages    PrivacyMessage[]

  @@index([userId])
  @@index([status])
}

model TagProfile {
  id                Int             @id @default(autoincrement())
  tagId             Int             @unique
  category          ProfileCategory
  petKind           PetKind?
  customLabel       String?
  displayName       String
  photoUrl          String?
  breed             String?
  sex               ProfileSex?
  isNeutered        Boolean?
  medicalNote       String?
  hasMicrochip      Boolean         @default(false)
  microchipCode     String?
  privacyMode       Boolean         @default(false)
  ownerPhone        String?
  backupPhone       String?
  notificationEmail String?
  homeAddress       String?
  showHomeAddress   Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tag               Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([displayName])
}

model ScanLog {
  id                     Int                @id @default(autoincrement())
  tagId                   Int
  scannedAt               DateTime           @default(now())
  locationSource          LocationSource
  latitude                Float?
  longitude               Float?
  city                    String?
  region                  String?
  country                 String?
  ipAddress               String?
  userAgent               String?
  mapUrl                  String?
  tagStatusAtScan         TagStatus
  notificationSuppressed  Boolean            @default(false)
  notificationStatus      NotificationStatus @default(PENDING)
  notificationSentAt      DateTime?
  dedupeKey               String?
  createdAt               DateTime           @default(now())
  tag                     Tag                @relation(fields: [tagId], references: [id], onDelete: Cascade)
  privacyMessages         PrivacyMessage[]

  @@index([tagId, scannedAt(sort: Desc)])
  @@index([tagId, ipAddress, scannedAt(sort: Desc)])
  @@index([notificationStatus])
}

model PrivacyMessage {
  id              Int            @id @default(autoincrement())
  tagId           Int
  scanLogId       Int?
  finderName      String?
  finderContact   String?
  message         String
  ipAddress       String?
  deliveryStatus  DeliveryStatus @default(PENDING)
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  tag             Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  scanLog         ScanLog?       @relation(fields: [scanLogId], references: [id], onDelete: SetNull)

  @@index([tagId, createdAt(sort: Desc)])
  @@index([scanLogId])
  @@index([deliveryStatus])
}
